# Copy this file to ".env" and fill in your real Supabase project details.
# Find these in your Supabase project: Settings > API

VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Trustpilot integration — leave blank to hide the ratings
# section until you have a real Trustpilot Business account.
VITE_TRUSTPILOT_BUSINESS_UNIT_ID=
VITE_TRUSTPILOT_DOMAIN=

# Where testimonial-submission notification emails should go
# (actual sending requires a Supabase Edge Function + email provider —
# see README-new-features.md for details)
ADMIN_NOTIFICATION_EMAIL=admin@example.com
